<div class="container py-5" style="max-width: 50%;">
  <div class="row justify-content-center">
    <div class="col-12">
      
      <!-- Header da Página -->
      <div class="text-center mb-5">
        <h1 class="display-6 text-primary fw-bold mb-3">
          <i class="fas fa-user-cog me-3"></i>
          Configurações da Conta
        </h1>
        <p class="lead text-muted">
          Gerencie suas informações pessoais e configurações de segurança
        </p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <!-- Card: Informações Pessoais -->
        <div class="card shadow mb-4" style="border-radius: 15px;">
          <div class="card-header bg-primary text-white py-3" style="border-radius: 15px 15px 0 0;">
            <h5 class="mb-0 fw-semibold">
              <i class="fas fa-user me-2"></i>
              Informações Pessoais
            </h5>
          </div>
          <div class="card-body p-4">
            <div class="mb-0">
              <%= f.label :email, class: "form-label fw-semibold text-dark mb-2" %>
              <%= f.email_field :email, 
                  class: "form-control form-control-lg shadow-sm", 
                  style: "border-radius: 10px; border: 2px solid #e9ecef;",
                  autofocus: true, 
                  autocomplete: "email" %>
              
              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <div class="alert alert-warning mt-3 mb-0 shadow-sm" role="alert" style="border-radius: 10px;">
                  <i class="fas fa-clock me-2"></i>
                  <strong>Pendente:</strong> Aguardando confirmação para <strong><%= resource.unconfirmed_email %></strong>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Card: Segurança e Senha -->
        <div class="card shadow mb-4" style="border-radius: 15px;">
          <div class="card-header bg-warning text-dark py-3" style="border-radius: 15px 15px 0 0;">
            <h5 class="mb-0 fw-semibold">
              <i class="fas fa-shield-alt me-2"></i>
              Segurança e Senha
            </h5>
          </div>
          <div class="card-body p-4">
            
            <!-- Nova Senha e Confirmação -->
            <div class="row mb-4">
              <div class="col-md-6 mb-3 mb-md-0">
                <%= f.label :password, "Nova Senha", class: "form-label fw-semibold text-dark mb-2" %>
                <small class="d-block text-muted mb-2">
                  <i class="fas fa-info-circle me-1"></i>
                  Deixe em branco para manter a atual
                </small>
                <%= f.password_field :password, 
                    class: "form-control shadow-sm", 
                    style: "border-radius: 10px; border: 2px solid #e9ecef;",
                    autocomplete: "new-password",
                    placeholder: "Digite sua nova senha" %>
                <% if @minimum_password_length %>
                  <div class="form-text text-primary">
                    <i class="fas fa-key me-1"></i>
                    Mínimo de <%= @minimum_password_length %> caracteres
                  </div>
                <% end %>
              </div>
              
              <div class="col-md-6">
                <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "form-label fw-semibold text-dark mb-2" %>
                <small class="d-block text-muted mb-2">
                  <i class="fas fa-check-double me-1"></i>
                  Repita a senha para confirmar
                </small>
                <%= f.password_field :password_confirmation, 
                    class: "form-control shadow-sm", 
                    style: "border-radius: 10px; border: 2px solid #e9ecef;",
                    autocomplete: "new-password",
                    placeholder: "Confirme sua nova senha" %>
              </div>
            </div>

            <hr class="my-4">

            <!-- Senha Atual -->
            <div class="mb-0">
              <%= f.label :current_password, class: "form-label fw-semibold text-danger mb-2" %>
              <span class="text-danger fs-5">*</span>
              <small class="d-block text-muted mb-2">
                <i class="fas fa-exclamation-circle me-1"></i>
                Por segurança, precisamos confirmar sua identidade
              </small>
              <%= f.password_field :current_password, 
                  class: "form-control shadow-sm", 
                  style: "border-radius: 10px; border: 2px solid #e9ecef;",
                  autocomplete: "current-password",
                  placeholder: "Digite sua senha atual para confirmar alterações",
                  required: true %>
            </div>
          </div>
        </div>

        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Botões de Ação -->
        <div class="d-flex gap-3 justify-content-end mb-5">
          <%= link_to :back, 
              class: "btn btn-outline-secondary btn-lg px-4 shadow-sm", 
              style: "border-radius: 10px;" do %>
            <i class="fas fa-arrow-left me-2"></i>Cancelar
          <% end %>
          
          <%= f.submit "Salvar Alterações", 
              class: "btn btn-success btn-lg px-5 shadow-sm", 
              style: "border-radius: 10px; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); border: none;",
              data: { 
                confirm: "Confirmar alterações na conta?",
                turbo_confirm: "Confirmar alterações na conta?" 
              } %>
        </div>

      <% end %>

      <!-- Card: Zona de Perigo -->
      <div class="card border-danger shadow" style="border-radius: 15px;">
        <div class="card-header bg-danger text-white py-3" style="border-radius: 15px 15px 0 0;">
          <h5 class="mb-0 fw-semibold">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Zona de Perigo
          </h5>
        </div>
        <div class="card-body p-4">
          <h6 class="card-title text-dark mb-3">Excluir Conta Permanentemente</h6>
          <p class="card-text text-muted mb-4">
            Uma vez excluída, sua conta não poderá ser recuperada. Todos os seus dados serão 
            <strong class="text-danger">perdidos permanentemente</strong>.
          </p>
          
          <div class="d-flex justify-content-between align-items-center flex-wrap">
            <small class="text-muted me-3">
              <i class="fas fa-info-circle me-1 text-warning"></i>
              Esta ação é <strong>irreversível</strong>
            </small>
            
            <%= button_to "Excluir Minha Conta", 
                registration_path(resource_name), 
                data: { 
                  confirm: "⚠️ ATENÇÃO: Esta ação é IRREVERSÍVEL!\n\nTodos os seus dados serão perdidos permanentemente.\n\nTem absoluta certeza que deseja continuar?",
                  turbo_confirm: "⚠️ ATENÇÃO: Esta ação é IRREVERSÍVEL!\n\nTodos os seus dados serão perdidos permanentemente.\n\nTem absoluta certeza que deseja continuar?" 
                }, 
                method: :delete,
                class: "btn btn-outline-danger shadow-sm",
                style: "border-radius: 8px;" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>