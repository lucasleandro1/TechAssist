<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Novo Ticket</h1>
  <%= link_to 'Voltar', tickets_path, class: 'btn btn-secondary' %>
</div>

<% if params[:mobile_device_id].present? %>
  <% mobile_device = MobileDevice.find_by(id: params[:mobile_device_id]) %>
  <% if mobile_device %>
    <div class="alert alert-success mb-4">
      <i class="fas fa-check-circle me-2"></i>
      <strong>Fluxo Automático:</strong> Criando ticket para <strong><%= mobile_device.client.nome %></strong> - Dispositivo: <strong><%= mobile_device.marca %> <%= mobile_device.modelo %></strong>
    </div>
  <% end %>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render 'form' %>
  </div>
</div>